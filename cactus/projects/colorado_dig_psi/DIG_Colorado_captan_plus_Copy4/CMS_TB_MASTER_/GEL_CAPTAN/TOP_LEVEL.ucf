##==============================================
#Timing





NET "SECONDARY_CLK" TNM_NET = SECONDARY_CLK;
TIMESPEC TS_SECONDARY_CLK = PERIOD "SECONDARY_CLK" 40 MHz HIGH 50%;

NET "GEL_RXCLK" TNM_NET = GEL_RXCLK;
TIMESPEC TS_GEL_RXCLK = PERIOD "GEL_RXCLK" 8 ns HIGH 50%;
#NET "MASTER_CLK" TNM_NET = MASTER_CLK;
#TIMESPEC TS_MASTER_CLK = PERIOD "MASTER_CLK" 8 ns HIGH 50%;


# GMII interface clocks.  RXCLK is used to drive TXCLK.
INST "PHY_RXD*" TNM = "TG_RX";
INST "PHY_RXER" TNM = "TG_RX";
INST "PHY_RXCTL_RXDV" TNM = "TG_RX";
#NET "GEL_RXCLK" TNM_NET = "TN_RXCLK";
#TIMESPEC "TS_RXCLK" = PERIOD "TN_RXCLK" 8 ns HIGH 50%;
# INPUT_JITTER 80 ps;
TIMEGRP "TG_RX" OFFSET = IN 0 ns VALID 4 NS BEFORE "GEL_RXCLK" RISING;



NET "XLXN_15849" TNM_NET = XLXN_15849;
TIMESPEC TS_XLXN_15849 = PERIOD "XLXN_15849" 40 MHz HIGH 50%; ##muxed psi input clock

NET "XLXN_18355" TNM_NET = XLXN_18355;
TIMESPEC TS_XLXN_18355 = PERIOD "XLXN_18355" 160 MHz HIGH 50%; ##DIG CLK 0
NET "XLXN_18372" TNM_NET = XLXN_18372;
TIMESPEC TS_XLXN_18372 = PERIOD "XLXN_18372" 160 MHz HIGH 50%; ##DIG CLK 1
#NET "XLXN_18597" TNM_NET = XLXN_18597;
#TIMESPEC TS_XLXN_18597 = PERIOD "XLXN_18597" 8 ns HIGH 50%; ##DIG CLK 2


INST "XLXI_4776" TIG; #trying to ignore "XLXI_4776/adc_clk_sel" 

#NET "XLXI_5685/XLXN_14691" TNM_NET = XLXI_5685XLXN_14691;
#TIMESPEC TS_XLXI_5685XLXN_14691 = PERIOD "XLXI_5685XLXN_14691" 17 ns HIGH 50%; ##ADC CLK IN

