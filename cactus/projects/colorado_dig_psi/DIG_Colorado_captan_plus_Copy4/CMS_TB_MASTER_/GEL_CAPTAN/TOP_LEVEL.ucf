#NET "ACC_CLK_IN" TNM_NET = "ACC_CLK_IN";
#TIMESPEC "TS_accclk_to_mclk" = FROM "ACC_CLK_IN" TO "MASTER_CLK" 8.0 ns DATAPATHONLY;
#TIMESPEC "TS_mclk_to_accclk" = FROM "MASTER_CLK" TO "ACC_CLK_IN" 8.0 ns DATAPATHONLY;




#NET "XLXI_5685/adc_delayed_clk" TNM_NET = adc_delayed_clk;
#TIMESPEC TS_adc_delayed_clk = PERIOD "adc_delayed_clk" 8 ns HIGH 50%; #put some sort of constraint on this clock


#NET "XLXN_12498" TNM_NET = "XLXN_12498";  #false path from any signal in XLXN_12498 source clock .. it is the slooow RESET clock
#TIMESPEC "TS_rstclk_to_all" = FROM "XLXN_12498" 16.0 ns DATAPATHONLY;

TIMESPEC "TS_digsclk_to_rstmclk" = FROM "psi_dig_sdata_clk0" TO "XLXN_12498" 8.0 ns DATAPATHONLY;
TIMESPEC "TS_rstmclk_to_digsclk" = FROM "XLXN_12498" TO "psi_dig_sdata_clk(0)" 8.0 ns DATAPATHONLY;
TIMESPEC "TS_digsclk1_to_rstmclk" = FROM "psi_dig_sdata_clk1" TO "XLXN_12498" 8.0 ns DATAPATHONLY;
TIMESPEC "TS_rstmclk_to_digsclk1" = FROM "XLXN_12498" TO "psi_dig_sdata_clk1" 8.0 ns DATAPATHONLY;
TIMESPEC "TS_digsclk2_to_rstmclk" = FROM "psi_dig_sdata_clk2" TO "XLXN_12498" 8.0 ns DATAPATHONLY;
TIMESPEC "TS_rstmclk_to_digsclk2" = FROM "XLXN_12498" TO "psi_dig_sdata_clk2" 8.0 ns DATAPATHONLY;

TIMESPEC "TS_mclk_to_rstmclk" = FROM "MASTER_CLK" TO "XLXN_12498" 8.0 ns DATAPATHONLY;
TIMESPEC "TS_rstmclk_to_mclk" = FROM "XLXN_12498" TO "MASTER_CLK" 8.0 ns DATAPATHONLY;



#TIMESPEC "TS_digsclk_to_psi90mclk" = FROM "psi_dig_sdata_clk0" TO "XLXN_15111" 8.0 ns DATAPATHONLY;
#TIMESPEC "TS_psi90mclk_to_digsclk" = FROM "XLXN_15111" TO "psi_dig_sdata_clk0" 8.0 ns DATAPATHONLY;
#TIMESPEC "TS_digsclk1_to_psi90mclk" = FROM "psi_dig_sdata_clk1" TO "XLXN_15111" 8.0 ns DATAPATHONLY;
#TIMESPEC "TS_psi90mclk_to_digsclk1" = FROM "XLXN_15111" TO "psi_dig_sdata_clk1" 8.0 ns DATAPATHONLY;

#set to datapathonly anything related to psi clk and master clk
NET "psi_dig_sdata_clk(0)" TNM_NET = "psi_dig_sdata_clk0";
TIMESPEC "TS_digsclk_to_mclk" = FROM "psi_dig_sdata_clk" TO "MASTER_CLK" 8.0 ns DATAPATHONLY;
TIMESPEC "TS_mclk_to_digsclk" = FROM "MASTER_CLK" TO "psi_dig_sdata_clk" 8.0 ns DATAPATHONLY;

NET "psi_dig_sdata_clk(1)" TNM_NET = "psi_dig_sdata_clk1";
TIMESPEC "TS_digsclk1_to_mclk" = FROM "psi_dig_sdata_clk1" TO "MASTER_CLK" 8.0 ns DATAPATHONLY;
TIMESPEC "TS_mclk_to_digsclk1" = FROM "MASTER_CLK" TO "psi_dig_sdata_clk1" 8.0 ns DATAPATHONLY;

NET "psi_dig_sdata_clk(2)" TNM_NET = "psi_dig_sdata_clk2";
TIMESPEC "TS_digsclk2_to_mclk" = FROM "psi_dig_sdata_clk2" TO "MASTER_CLK" 8.0 ns DATAPATHONLY;
TIMESPEC "TS_mclk_to_digsclk2" = FROM "MASTER_CLK" TO "psi_dig_sdata_clk2" 8.0 ns DATAPATHONLY;


#NET "GTX_CLK_0_sig" TNM_NET = "GTX_CLK_0_sig";
TIMESPEC "TS_digsclk_to_gtxclk" = FROM "psi_dig_sdata_clk" TO "GEL_RXCLK" 8.0 ns DATAPATHONLY;
TIMESPEC "TS_gtxclk_to_digsclk" = FROM "GEL_RXCLK" TO "psi_dig_sdata_clk" 8.0 ns DATAPATHONLY;
TIMESPEC "TS_digsclk1_to_gtxclk" = FROM "psi_dig_sdata_clk1" TO "GEL_RXCLK" 8.0 ns DATAPATHONLY;
TIMESPEC "TS_gtxclk_to_digsclk1" = FROM "GEL_RXCLK" TO "psi_dig_sdata_clk1" 8.0 ns DATAPATHONLY;
TIMESPEC "TS_digsclk2_to_gtxclk" = FROM "psi_dig_sdata_clk2" TO "GEL_RXCLK" 8.0 ns DATAPATHONLY;
TIMESPEC "TS_gtxclk_to_digsclk2" = FROM "GEL_RXCLK" TO "psi_dig_sdata_clk2" 8.0 ns DATAPATHONLY;
