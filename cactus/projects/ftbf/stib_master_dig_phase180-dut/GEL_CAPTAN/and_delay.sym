VERSION 5
BEGIN SYMBOL and_delay
SYMBOLTYPE BLOCK
TIMESTAMP 2008 8 12 12 56 56
SYMPIN 0 -288 Input reset_n
SYMPIN 0 -224 Input clk
SYMPIN 0 -160 Input we
SYMPIN 0 -96 Input sig_in
SYMPIN 384 -288 Output sig_out
SYMPIN 0 96 Input data(16:0)
BEGIN DISPLAY 192 -328 ATTR SymbolName
    ALIGNMENT BCENTER
    FONT 56 "Arial"
END DISPLAY
BEGIN DISPLAY 72 -288 PIN reset_n ATTR PinName
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 72 -224 PIN clk ATTR PinName
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 72 -160 PIN we ATTR PinName
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 72 -96 PIN sig_in ATTR PinName
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 312 -288 PIN sig_out ATTR PinName
    ALIGNMENT RIGHT
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 72 96 PIN data(16:0) ATTR PinName
    FONT 24 "Arial"
END DISPLAY
RECTANGLE N 0 84 64 108 
LINE N 64 96 0 96 
LINE N 64 -288 0 -288 
LINE N 64 -224 0 -224 
LINE N 64 -160 0 -160 
LINE N 64 -96 0 -96 
LINE N 320 -288 384 -288 
RECTANGLE N 64 -320 320 128 
END SYMBOL
