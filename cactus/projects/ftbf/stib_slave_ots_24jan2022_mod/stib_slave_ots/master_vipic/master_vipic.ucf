#
#  Connector J19
#
NET "VIPIC_SOUT_PAD_P<0>" LOC = AA4;    # pin 23
NET "VIPIC_SOUT_PAD_N<0>" LOC = AA3;    # pin 24
NET "VIPIC_SOUT_PAD_P<1>" LOC = W6;     # pin 27
NET "VIPIC_SOUT_PAD_N<1>" LOC = W5;     # pin 28
NET "VIPIC_SOUT_PAD_P<2>" LOC = W7;     # pin 33
NET "VIPIC_SOUT_PAD_N<2>" LOC = V7;     # pin 34
NET "VIPIC_SOUT_PAD_P<3>" LOC = P8;     # pin 37
NET "VIPIC_SOUT_PAD_N<3>" LOC = N8;     # pin 38

#
#  Connector J21
#
NET "VIPIC_SIN_PAD_P<0>" LOC = H6;   # pin 23
NET "VIPIC_SIN_PAD_N<0>" LOC = H5;   # pin 24
NET "VIPIC_SIN_PAD_P<1>" LOC = H4;   # pin 27
NET "VIPIC_SIN_PAD_N<1>" LOC = H3;   # pin 28
NET "VIPIC_SIN_PAD_P<2>" LOC = J2;   # pin 33
NET "VIPIC_SIN_PAD_N<2>" LOC = J1;   # pin 34
NET "VIPIC_SIN_PAD_P<3>" LOC = J7;   # pin 37
NET "VIPIC_SIN_PAD_N<3>" LOC = J6;   # pin 38
NET "VIPIC_SIN_PAD_P<4>" LOC = C5;   # pin 43
NET "VIPIC_SIN_PAD_N<4>" LOC = D5;   # pin 44
NET "VIPIC_SIN_PAD_P<5>" LOC = E13;  # pin 47
NET "VIPIC_SIN_PAD_N<5>" LOC = D12;  # pin 48
NET "VIPIC_SIN_PAD_P<6>" LOC = L4;   # pin 49
NET "VIPIC_SIN_PAD_N<6>" LOC = L3;   # pin 50
NET "VIPIC_SIN_PAD_P<7>" LOC = C2;   # pin 5
NET "VIPIC_SIN_PAD_N<7>" LOC = C1;   # pin 6
NET "VIPIC_SIN_PAD_P<8>" LOC = H8;   # pin 9
NET "VIPIC_SIN_PAD_N<8>" LOC = H7;   # pin 10
NET "VIPIC_SIN_PAD_P<9>" LOC = G6;   # pin 15
NET "VIPIC_SIN_PAD_N<9>" LOC = G5;   # pin 16
NET "VIPIC_SIN_PAD_P<10>" LOC = F8;   # pin 17
NET "VIPIC_SIN_PAD_N<10>" LOC = G8;   # pin 18
NET "VIPIC_SIN_PAD_P<11>" LOC = G2;   # pin 25
NET "VIPIC_SIN_PAD_N<11>" LOC = G1;   # pin 26
NET "VIPIC_SIN_PAD_P<12>" LOC = H2;   # pin 29
NET "VIPIC_SIN_PAD_N<12>" LOC = H1;   # pin 30
NET "VIPIC_SIN_PAD_P<13>" LOC = J5;   # pin 37
NET "VIPIC_SIN_PAD_N<13>" LOC = J4;   # pin 38
NET "VIPIC_SIN_PAD_P<14>" LOC = L1;   # pin 39
NET "VIPIC_SIN_PAD_N<14>" LOC = K1;   # pin 40
NET "VIPIC_SIN_PAD_P<15>" LOC = A9;   # pin 45
NET "VIPIC_SIN_PAD_N<15>" LOC = B9;   # pin 46


#
#  Connector J24
#
NET "VIPIC_SERIAL_CLK_PAD_P" LOC = C4; # pin 25
NET "VIPIC_SERIAL_CLK_PAD_N" LOC = D4; # pin 26
NET "VIPIC_RSTROBE_PAD_P" LOC = M4;    # pin 29
NET "VIPIC_RSTROBE_PAD_N" LOC = M3;    # pin 30
NET "VIPIC_CLEAN_PAD_P" LOC = N7;      # pin 23
NET "VIPIC_CLEAN_PAD_N" LOC = M7;      # pin 24
NET "VIPIC_RESTART_PAD_P" LOC = M6;    # pin 27
NET "VIPIC_RESTART_PAD_N" LOC = M5;    # pin 28
NET "VIPIC_TSCLK_PAD" LOC = G10;       # pin 9
NET "VIPIC_SCIN_PAD<0>" LOC = E1;      # pin 35    connects to S_out
NET "VIPIC_SCIN_PAD<1>" LOC = F1;      # pin 36    connects to R_out
NET "VIPIC_SCIN_PAD<2>" LOC = F4;      # pin 37    connects to D_out
NET "VIPIC_SCOUT_PAD<0>" LOC = G9;     # pin 10    connects to S_in
NET "VIPIC_SCOUT_PAD<1>" LOC = D1;     # pin 6     connects to R_in
NET "VIPIC_SCOUT_PAD<2>" LOC = D2;     # pin 5     connects to D_in
NET "VIPIC_SCCLK_PAD<0>" LOC = E3;     # pin 15    connects to S_clk
NET "VIPIC_SCCLK_PAD<1>" LOC = E2;     # pin 16    connects to R_clk
NET "VIPIC_SCCLK_PAD<2>" LOC = B6;     # pin 17    connects to D_clk
NET "VIPIC_STROBE_PAD_P" LOC = G4;     # pin 43
NET "VIPIC_STROBE_PAD_N" LOC = G3;     # pin 44
NET "VIPIC_LOAD_PAD" LOC = C6;         # pin 18
NET "VIPIC_HITOR_PAD" LOC = M2;        # pin 33

#
#  Align input signals with output clock
#
INST "VIPIC_SIN_PAD_P<0>" TNM = TG_SIN;
INST "VIPIC_SIN_PAD_P<1>" TNM = TG_SIN;
INST "VIPIC_SIN_PAD_P<2>" TNM = TG_SIN;
INST "VIPIC_SIN_PAD_P<3>" TNM = TG_SIN;
INST "VIPIC_SIN_PAD_P<4>" TNM = TG_SIN;
INST "VIPIC_SIN_PAD_P<5>" TNM = TG_SIN;
INST "VIPIC_SIN_PAD_P<6>" TNM = TG_SIN;
INST "VIPIC_SIN_PAD_P<7>" TNM = TG_SIN;
INST "VIPIC_SIN_PAD_P<8>" TNM = TG_SIN;
INST "VIPIC_SIN_PAD_P<9>" TNM = TG_SIN;
INST "VIPIC_SIN_PAD_P<10>" TNM = TG_SIN;
INST "VIPIC_SIN_PAD_P<11>" TNM = TG_SIN;
INST "VIPIC_SIN_PAD_P<12>" TNM = TG_SIN;
INST "VIPIC_SIN_PAD_P<13>" TNM = TG_SIN;
INST "VIPIC_SIN_PAD_P<14>" TNM = TG_SIN;
INST "VIPIC_SIN_PAD_P<15>" TNM = TG_SIN;

# TIMEGRP "TG_SIN" OFFSET = IN 4 ns VALID 8 NS BEFORE "VIPIC_SERIAL_CLK_PAD_P" RISING;

# GMII interface clocks.  RXCLK is used to drive TXCLK.
INST "GMII_RXD_PAD*" TNM = "TG_RX";
INST "GMII_RXER_PAD" TNM = "TG_RX";
INST "GMII_RXDV_PAD" TNM = "TG_RX";
NET "gmii_rxclk_pad" TNM_NET = "TN_RXCLK";
TIMESPEC "TS_RXCLK" = PERIOD "TN_RXCLK" 8 ns HIGH 50%;
TIMEGRP "TG_RX" OFFSET = IN 4 ns VALID 8 NS BEFORE "gmii_rxclk_pad" RISING;

# The 5 MHz input clock is used for the SPI interface...
NET "clk5mhz_pad" TNM_NET = "TN_CLK5MHZ";
TIMESPEC "TS_CLK5MHZ" = PERIOD "TN_CLK5MHZ" 5 MHZ HIGH 50%;

# The 15 ns clock drives the core and the FSSR2 clocks
NET "clk15ns_pad" TNM_NET = "TN_CLK15NS";
TIMESPEC "TS_CLK15NS" = PERIOD "TN_CLK15NS" 15 ns HIGH 50%;
#Created by Constraints Editor (xc4vlx25-ff668-10) - 2014/07/31
NET "bdclk_in_pad_p" TNM_NET = "bdclk_in_pad_p";
TIMESPEC TS_bdclk_in_pad_p = PERIOD "bdclk_in_pad_p" 37 ns HIGH 50%;

NET "tlk_rxclk_pad" TNM_NET = tlk_rxclk_pad;
TIMESPEC TS_tlk_rxclk_pad = PERIOD "tlk_rxclk_pad" 8 ns HIGH 50%;
TIMESPEC TS_GTXCLK_TO_BUSCLK = FROM "tlk_imp_tlkclk_clkfx" TO "TN_CLK15NS" TIG;
TIMESPEC TS_BUSCLK_TO_GTXCLK = FROM "TN_CLK15NS" TO "tlk_imp_tlkclk_clkfx" TIG;
TIMESPEC TS_BUSCLK_TO_BDCLK = FROM "TN_CLK15NS" TO "bdclk_in_pad_p" TIG;
TIMESPEC TS_BDCLK_TO_BUSCLK = FROM "bdclk_in_pad_p" TO "TN_CLK15NS" TIG;

NET "vipic_imp/vipicclk_imp/dcm_tsclk_div" TNM_NET = "TN_sclkdiv";
TIMESPEC TS_SCLKDIV_TO_BUSCLK = FROM "TN_sclkdiv" TO "TN_CLK15NS" TIG;
NET "vipic_imp/vipicclk_imp/tscounter_clock" TNM_NET = "TN_tscclk";
TIMESPEC TS_TSCCLK_TO_BUSCLK = FROM "TN_tscclk" TO "TN_CLK15NS" TIG;

#
#  This constraint places the sclk_dcm near the clk15ns global clock buffer.
#
INST "vipic_imp/vipicclk_imp/sclk_dcm" LOC = "DCM_ADV_X0Y1";
INST "vipic_imp/vipicclk_imp/tsclkmux_imp" LOC = "BUFGCTRL_X0Y31" ;

