## This is for the TLK3101 interface
#NET "TLK_TXD_PAD<0>" LOC = D10;
#NET "TLK_TXD_PAD<1>" LOC = D9;
#NET "TLK_TXD_PAD<2>" LOC = A8;
#NET "TLK_TXD_PAD<3>" LOC = D8;
#NET "TLK_TXD_PAD<4>" LOC = F10;
#NET "TLK_TXD_PAD<5>" LOC = A6;
#NET "TLK_TXD_PAD<6>" LOC = E9;
#NET "TLK_TXD_PAD<7>" LOC = E7;
#NET "TLK_TXD_PAD<8>" LOC = C8;
#NET "TLK_TXD_PAD<9>" LOC = A7;
#NET "TLK_TXD_PAD<10>" LOC = D7;
#NET "TLK_TXD_PAD<11>" LOC = E10;
#NET "TLK_TXD_PAD<12>" LOC = A5;
#NET "TLK_TXD_PAD<13>" LOC = F9;
#NET "TLK_TXD_PAD<14>" LOC = D6;
#NET "TLK_TXD_PAD<15>" LOC = G7;
#NET "TLK_GTX_CLK_PAD" LOC = C10;
#NET "TLK_LCKREFN_PAD" LOC = D15;
#NET "TLK_PREM_PAD" LOC = D16;
#NET "TLK_TXEN_PAD" LOC = C16;
#NET "TLK_TXER_PAD" LOC = C11;
#NET "TLK_ENABLE_PAD" LOC = E14;
#NET "TLK_LOOPEN_PAD" LOC = D11;
#NET "TLK_PRBSEN_PAD" LOC = D13;
#NET "TLK_TESTEN_PAD" LOC = D14;
#NET "TLK_RXER_PAD" LOC = F15;
#NET "TLK_RXDV_PAD" LOC = F16;
#NET "TLK_RXCLK_PAD" LOC = C15;
#NET "TLK_RXD_PAD<0>" LOC = C17;
#NET "TLK_RXD_PAD<1>" LOC = C20;
#NET "TLK_RXD_PAD<2>" LOC = B18;
#NET "TLK_RXD_PAD<3>" LOC = D20;
#NET "TLK_RXD_PAD<4>" LOC = C21;
#NET "TLK_RXD_PAD<5>" LOC = E17;
#NET "TLK_RXD_PAD<6>" LOC = C19;
#NET "TLK_RXD_PAD<7>" LOC = G19;
#NET "TLK_RXD_PAD<8>" LOC = D17;
#NET "TLK_RXD_PAD<9>" LOC = B20;
#NET "TLK_RXD_PAD<10>" LOC = A18;
#NET "TLK_RXD_PAD<11>" LOC = D19;
#NET "TLK_RXD_PAD<12>" LOC = B21;
#NET "TLK_RXD_PAD<13>" LOC = F17;
#NET "TLK_RXD_PAD<14>" LOC = D18;
#NET "TLK_RXD_PAD<15>" LOC = F19;
#NET "TLK_RXCLK_PAD" CLOCK_DEDICATED_ROUTE = FALSE;
#NET "SFP_ENABLEN_PAD" LOC = G22;
#NET "SFP_TXDIS_PAD" LOC = B24;
#NET "SFP_RS_PAD" LOC = G21;
#NET "SFP_TXFAULT_PAD" LOC = E24;
#NET "SFP_MODABS_PAD" LOC = E25;
#NET "SFP_LOS_PAD" LOC = B23;

# GMII interface clocks.  RXCLK is used to drive TXCLK.
INST "GMII_RXD_PAD*" TNM = "TG_RX";
INST "GMII_RXER_PAD" TNM = "TG_RX";
INST "GMII_RXDV_PAD" TNM = "TG_RX";
NET "GMII_RXCLK_PAD" TNM_NET = "TN_RXCLK";
TIMESPEC "TS_RXCLK" = PERIOD "TN_RXCLK" 8 ns HIGH 50% INPUT_JITTER 80 ps;
#TIMEGRP "TG_RX" OFFSET = IN 4 ns VALID 8 NS BEFORE "GMII_RXCLK_PAD" RISING;
# The 5 MHz input clock is used for the SPI interface...
NET "CLK5MHZ_PAD" TNM_NET = "TN_CLK5MHZ";
TIMESPEC "TS_CLK5MHZ" = PERIOD "TN_CLK5MHZ" 5 MHZ HIGH 50%;


#RAR
NET "GMII_RXCLK_PAD" IOSTANDARD = LVCMOS25;
NET "CLK15NS_PAD" IOSTANDARD = LVCMOS25;
#end RAR

NET "CLK15NS_PAD" TNM_NET = CLK15NS_PAD;
TIMESPEC TS_CLK15NS_PAD = PERIOD "CLK15NS_PAD" 15 ns HIGH 50%;
NET "EXT_CLK_PAD_P" TNM_NET = EXT_CLK_PAD_P;
TIMESPEC TS_EXT_CLK_PAD_P = PERIOD "EXT_CLK_PAD_P" 37 ns HIGH 50%;
#RAR NET "TLK_RXCLK_PAD" TNM_NET = TLK_RXCLK_PAD;
#RAR TIMESPEC TS_TLK_RXCLK_PAD = PERIOD "TLK_RXCLK_PAD" 8 ns HIGH 50%;

#RAR NET "TLK_GTX_CLK" TNM_NET = TN_GTXCLK;
NET "strip_imp/stripclk_imp/clk_q" TNM_NET = "TN_CLKQ";
NET "strip_imp/dcm_outclk" TNM_NET = "TN_OUTCLK";

			NET "strip_imp/strip_mclk<0>" TNM_NET = "TN_STRIP_MCLK"; #When STRIPs are out RAR

NET "strip_imp/stripclk_imp/dcm_mclk_a" TNM_NET = TN_STRIP_MCLKA;
NET "strip_imp/stripclk_imp/dcm_mclk_b" TNM_NET = TN_STRIP_MCLKB;
NET "strip_imp/fracbcoclk" TNM_NET = "TN_FBCOCLK";
#NET "strip_imp/stripclk_imp/dcm_fbco_fx" TNM_NET = "TN_STRIP_DAC_CLK"; #RAR .. this was not the DAC clock??
NET "strip_imp/stripclk_imp/dcm_mclk_fx" TNM_NET = "TN_STRIP_DAC_CLK";
NET "STRIP_BCOCLK<0>" TNM_NET = "TN_BCOCLK";

#Created by Constraints Editor (xc4vlx25-ff668-10) - 2014/08/30
TIMESPEC TS_BUSCLK_TO_MCLKA = FROM "CLK15NS_PAD" TO "TN_STRIP_MCLKA" TIG;
TIMESPEC TS_BUSCLK_TO_MCLKB = FROM "CLK15NS_PAD" TO "TN_STRIP_MCLKB" TIG;
TIMESPEC TS_MCLKA_TO_BUSCLK = FROM "TN_STRIP_MCLKA" TO "CLK15NS_PAD" TIG;
TIMESPEC TS_MCLKB_TO_BUSCLK = FROM "TN_STRIP_MCLKB" TO "CLK15NS_PAD" TIG;
TIMESPEC TS_BUSCLK_TO_DACCLK = FROM "CLK15NS_PAD" TO "TN_STRIP_DAC_CLK" TIG;
TIMESPEC TS_BUSCLK_TO_FBCOCLK = FROM "CLK15NS_PAD" TO "TN_FBCOCLK" TIG;
TIMESPEC TS_FBCOCLK_TO_BUSCLK = FROM "TN_FBCOCLK" TO "CLK15NS_PAD" TIG;
TIMESPEC TS_EXTCLK_TO_DACCLK = FROM "EXT_CLK_PAD_P" TO "TN_STRIP_DAC_CLK" TIG;

TIMESPEC TS_BCOCLK_TO_DACCLK = FROM "TN_BCOCLK" TO "TN_STRIP_DAC_CLK" TIG;

TIMESPEC TS_BUSCLK_TO_BCOCLK = FROM "CLK15NS_PAD" TO "TN_BCOCLK" TIG;
TIMESPEC TS_BCOCLK_TO_BUSCLK = FROM "TN_BCOCLK" TO "CLK15NS_PAD" TIG;
TIMESPEC TS_BCOCLK_TO_MCLKA = FROM "TN_BCOCLK" TO "TN_STRIP_MCLKA" TIG;
TIMESPEC TS_BCOCLK_TO_MCLKB = FROM "TN_BCOCLK" TO "TN_STRIP_MCLKB" TIG;
TIMESPEC TS_MCLKA_TO_BCOCLK = FROM "TN_STRIP_MCLKA" TO "TN_BCOCLK" TIG;
TIMESPEC TS_MCLKB_TO_BCOCLK = FROM "TN_STRIP_MCLKB" TO "TN_BCOCLK" TIG;

TIMESPEC TS_FBCOCLK_TO_MCLKA = FROM "TN_FBCOCLK" TO "TN_STRIP_MCLKA" TIG;
TIMESPEC TS_MCLKA_TO_FBCOCLK = FROM "TN_STRIP_MCLKA" TO "TN_FBCOCLK" TIG;
TIMESPEC TS_BUSCLK_TO_TLKCLK = FROM "CLK15NS_PAD" TO "TLK_RXCLK_PAD" TIG;

TIMESPEC TS_CLKQ_TO_DACCLK = FROM "TN_CLKQ" TO "TN_STRIP_DAC_CLK" TIG;
TIMESPEC TS_GTXCLK_TO_BUSCLK = FROM "TN_GTXCLK" TO "CLK15NS_PAD" TIG;
TIMESPEC TS_BUSCLK_TO_GTXCLK = FROM "CLK15NS_PAD" TO "TN_GTXCLK" TIG;
TIMESPEC TS_CLKQ_TO_BUSCLK = FROM "TN_CLKQ" TO "CLK15NS_PAD" TIG;

TIMESPEC TS_BCOCLK_TO_OUTCLK = FROM "TN_BCOCLK" TO "TN_OUTCLK" TIG;

TIMESPEC TS_MCLK_TO_MCLKA = FROM "TN_STRIP_MCLK" TO "TN_STRIP_MCLKA" TIG;
TIMESPEC TS_MCLK_TO_MCLKB = FROM "TN_STRIP_MCLK" TO "TN_STRIP_MCLKB" TIG;
