VERSION 5
BEGIN SYMBOL ADC_single_frame_counter
SYMBOLTYPE BLOCK
TIMESTAMP 2009 3 11 20 7 27
SYMPIN 0 -160 Input ADC_clk
SYMPIN 0 -96 Input ADC_frame
SYMPIN 0 -32 Input rst_n
SYMPIN 384 -160 Output ADC_en
RECTANGLE N 64 -192 320 0 
BEGIN DISPLAY 192 -200 ATTR SymbolName
    ALIGNMENT BCENTER
    FONT 56 "Arial"
END DISPLAY
BEGIN DISPLAY 72 -160 PIN ADC_clk ATTR PinName
    FONT 24 "Arial"
END DISPLAY
LINE N 64 -160 0 -160 
BEGIN DISPLAY 72 -96 PIN ADC_frame ATTR PinName
    FONT 24 "Arial"
END DISPLAY
LINE N 64 -96 0 -96 
BEGIN DISPLAY 72 -32 PIN rst_n ATTR PinName
    FONT 24 "Arial"
END DISPLAY
LINE N 64 -32 0 -32 
BEGIN DISPLAY 312 -160 PIN ADC_en ATTR PinName
    ALIGNMENT RIGHT
    FONT 24 "Arial"
END DISPLAY
LINE N 320 -160 384 -160 
END SYMBOL
