VERSION 5
BEGIN SYMBOL token_gen
SYMBOLTYPE BLOCK
TIMESTAMP 2008 8 8 19 38 33
SYMPIN 0 -160 Input clock_40
SYMPIN 0 -96 Input reset_n
SYMPIN 0 -32 Input rep_count(9:0)
SYMPIN 384 -160 Output token_out
SYMPIN 0 32 Input we
SYMPIN 0 96 Input we_clk
BEGIN DISPLAY 192 -200 ATTR SymbolName
    ALIGNMENT BCENTER
    FONT 56 "Arial"
END DISPLAY
BEGIN DISPLAY 72 -160 PIN clock_40 ATTR PinName
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 72 -96 PIN reset_n ATTR PinName
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 72 -32 PIN rep_count(9:0) ATTR PinName
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 312 -160 PIN token_out ATTR PinName
    ALIGNMENT RIGHT
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 72 32 PIN we ATTR PinName
    FONT 24 "Arial"
END DISPLAY
LINE N 64 32 0 32 
BEGIN DISPLAY 72 96 PIN we_clk ATTR PinName
    FONT 24 "Arial"
END DISPLAY
LINE N 64 96 0 96 
LINE N 64 -160 0 -160 
LINE N 64 -96 0 -96 
RECTANGLE N 0 -44 64 -20 
LINE N 64 -32 0 -32 
LINE N 320 -160 384 -160 
RECTANGLE N 64 -192 320 128 
END SYMBOL
