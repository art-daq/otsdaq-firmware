VERSION 5
BEGIN SYMBOL ADC_block_2
SYMBOLTYPE BLOCK
TIMESTAMP 2008 11 6 22 11 12
SYMPIN 0 -160 Input DCK
SYMPIN 0 32 Input D0_IN
SYMPIN 0 96 Input D1_IN
SYMPIN 384 32 Output D0
SYMPIN 384 96 Output D1
SYMPIN 384 -64 Output DOUT(11:0)
BEGIN DISPLAY 192 -200 ATTR SymbolName
    ALIGNMENT BCENTER
    FONT 56 "Arial"
END DISPLAY
BEGIN DISPLAY 72 -160 PIN DCK ATTR PinName
    FONT 24 "Arial"
END DISPLAY
LINE N 64 -160 0 -160 
RECTANGLE N 64 -192 320 128 
BEGIN DISPLAY 72 32 PIN D0_IN ATTR PinName
    FONT 24 "Arial"
END DISPLAY
LINE N 64 32 0 32 
BEGIN DISPLAY 72 96 PIN D1_IN ATTR PinName
    FONT 24 "Arial"
END DISPLAY
LINE N 64 96 0 96 
BEGIN DISPLAY 312 32 PIN D0 ATTR PinName
    ALIGNMENT RIGHT
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 312 96 PIN D1 ATTR PinName
    ALIGNMENT RIGHT
    FONT 24 "Arial"
END DISPLAY
LINE N 320 32 384 32 
LINE N 320 96 384 96 
BEGIN DISPLAY 312 -64 PIN DOUT(11:0) ATTR PinName
    ALIGNMENT RIGHT
    FONT 24 "Arial"
END DISPLAY
RECTANGLE N 320 -76 384 -52 
LINE N 320 -64 384 -64 
END SYMBOL
