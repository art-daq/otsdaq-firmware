VERSION 5
BEGIN SYMBOL CAPTAN_trig_0
SYMBOLTYPE BLOCK
TIMESTAMP 2008 8 11 15 45 14
SYMPIN 0 -224 Input clock_40_0
SYMPIN 0 -160 Input reset_n
SYMPIN 0 -96 Input we
SYMPIN 0 -32 Input data_in(31:0)
SYMPIN 384 -224 Output busy
SYMPIN 384 -32 Output trig_out
BEGIN DISPLAY 192 -264 ATTR SymbolName
    ALIGNMENT BCENTER
    FONT 56 "Arial"
END DISPLAY
BEGIN DISPLAY 72 -224 PIN clock_40_0 ATTR PinName
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 72 -160 PIN reset_n ATTR PinName
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 72 -96 PIN we ATTR PinName
    FONT 24 "Arial"
END DISPLAY
BEGIN DISPLAY 72 -32 PIN data_in(31:0) ATTR PinName
