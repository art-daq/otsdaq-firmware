# The 15 ns clock drives the core and the FSSR2 clocks
NET "CLK15NS_PAD" TNM_NET = "TN_CLK15NS";
TIMESPEC "TS_CLK15NS" = PERIOD "TN_CLK15NS" 15 ns HIGH 50%;

# GMII interface clocks.  RXCLK is used to drive TXCLK.
INST "GMII_RXD_PAD*" TNM = "TG_RX";
INST "GMII_RXER_PAD" TNM = "TG_RX";
INST "GMII_RXDV_PAD" TNM = "TG_RX";
NET "GMII_RXCLK_PAD" TNM_NET = "TN_RXCLK";
TIMESPEC "TS_RXCLK" = PERIOD "TN_RXCLK" 8 ns HIGH 50%;
TIMEGRP "TG_RX" OFFSET = IN 4 ns VALID 8 NS BEFORE "GMII_RXCLK_PAD" RISING;

#
# The 5 MHz input clock is used for the SPI interface...
# NET "CLK5MHZ_PAD" TNM_NET = "TN_CLK5MHZ";
# TIMESPEC "TS_CLK5MHZ" = PERIOD "TN_CLK5MHZ" 5 MHZ HIGH 50%;
#
# This decouples the IOBUS clock and the SPI clock
# TIMESPEC "TS_XDOMAIN2" = FROM "TN_CLK15NS" TO "TN_CLK5MHZ" TIG;
#Created by Constraints Editor (xc4vlx25-ff668-10) - 2014/03/30
NET "TLK_RXCLK_PAD" TNM_NET = TLK_RXCLK_PAD;
TIMESPEC TS_TLK_RXCLK_PAD = PERIOD "TLK_RXCLK_PAD" 8 ns HIGH 50%;
NET "BDCLK_IN_PAD_P" TNM_NET = TN_BDCLK_IN_PAD_P;
TIMESPEC "TS_BDCLK_IN_PAD_P" = PERIOD "BDCLK_IN_PAD_P" 20 ns HIGH 50%;
#Created by Constraints Editor (xc4vlx25-ff668-10) - 2014/06/08
NET "BDCLK_IN_PAD_P" TNM_NET = BDCLK_IN_PAD_P;
#Created by Constraints Editor (xc4vlx25-ff668-10) - 2014/06/09
NET "BDCLK_IN_PAD_N" TNM_NET = BDCLK_IN_PAD_N;
TIMESPEC TS_BDCLK_IN_PAD_N = PERIOD "BDCLK_IN_PAD_N" TS_BDCLK_IN_PAD_P PHASE 10 ns HIGH 50%;
#Created by Constraints Editor (xc4vlx25-ff668-10) - 2014/06/09
TIMESPEC TS_TLKCLK_TO_BUSCLK = FROM "tlk_imp_tlkclk_clkfx" TO "TN_CLK15NS" TIG;
TIMESPEC TS_BUSCLK_TO_TLKCLK = FROM "TN_CLK15NS" TO "tlk_imp_tlkclk_clkfx" TIG;
