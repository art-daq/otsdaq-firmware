        "U_ila_pro_0/U0/I_NO_D.U_ILA/U_TRIG/U_TM/G_NMU[0].U_M/U_MU/I_MUT_GANDX.U_match/I_SRL16.U_GANDX_SRL16/I_TW_GTE4.F_TW[1].I_YES_RPM.U_MUXH/O.SLICEM_FMC15_BLACKBOX"
        BEL
        "U_ila_pro_0/U0/I_NO_D.U_ILA/U_TRIG/U_TC/I_STORAGE_QUAL.U_STORAGE_QUAL/I_SRLT_NE_1.I_NMU_1_TO_4.U_TCL/I_NMU_EQ1.U_iDOUT/I_NOLUT6.I_SRL_T2.U_SRLC16E"
        BEL
        "U_ila_pro_0/U0/I_NO_D.U_ILA/U_TRIG/U_TC/I_TSEQ_NEQ2.U_TC_EQUATION/I_SRLT_NE_1.I_NMU_1_TO_4.U_TCL/I_NMU_EQ1.U_iDOUT/I_NOLUT6.I_SRL_T2.U_SRLC16E"
        BEL
        "U_ila_pro_0/U0/I_NO_D.U_ILA/U_TRIG/U_TC/I_STORAGE_QUAL.U_STORAGE_QUAL/I_SRLT_NE_1.I_NMU_1_TO_4.U_TCL/iDOUT.SLICEM_GMC15_BLACKBOX"
        PIN
        "U_ila_pro_0/U0/I_NO_D.U_ILA/U_CAPSTOR/I_CASE1.I_NO_TB.I_RT1.U_RAM/G_BRAM[0].U_BRAM/ram_rt1_s1_s32_if.ram_rt1_s1_s32_i_pins<23>";
TIMEGRP U_CLK = BEL "U_icon_pro/U0/U_ICON/U_iDATA_CMD";
TIMEGRP D2_CLK = BEL "U_ila_pro_0/U0/I_NO_D.U_ILA/U_STAT/U_DIRTY_LDC";
TIMEGRP GMII_RXGRP = BEL "GMII_RXDV_PAD" BEL "GMII_RXD_PAD<0>" BEL
        "GMII_RXD_PAD<1>" BEL "GMII_RXD_PAD<2>" BEL "GMII_RXD_PAD<3>" BEL
        "GMII_RXD_PAD<4>" BEL "GMII_RXD_PAD<5>" BEL "GMII_RXD_PAD<6>" BEL
        "GMII_RXD_PAD<7>" BEL "GMII_RXER_PAD";
TIMEGRP TG_RX = BEL "GMII_RXDV_PAD" BEL "GMII_RXD_PAD<0>" BEL
        "GMII_RXD_PAD<1>" BEL "GMII_RXD_PAD<2>" BEL "GMII_RXD_PAD<3>" BEL
        "GMII_RXD_PAD<4>" BEL "GMII_RXD_PAD<5>" BEL "GMII_RXD_PAD<6>" BEL
        "GMII_RXD_PAD<7>" BEL "GMII_RXER_PAD";
TIMEGRP "FFS" = FFS(*);
PATH TS_D2_TO_T2_ila_pro_0_path = FROM TIMEGRP "D2_CLK" TO TIMEGRP "FFS";
PATH "TS_D2_TO_T2_ila_pro_0_path" TIG;
PATH TS_J2_TO_D2_ila_pro_0_path = FROM TIMEGRP "FFS" TO TIMEGRP "D2_CLK";
PATH "TS_J2_TO_D2_ila_pro_0_path" TIG;
PATH TS_J3_TO_D2_ila_pro_0_path = FROM TIMEGRP "FFS" TO TIMEGRP "D2_CLK";
PATH "TS_J3_TO_D2_ila_pro_0_path" TIG;
PATH TS_J4_TO_D2_ila_pro_0_path = FROM TIMEGRP "FFS" TO TIMEGRP "D2_CLK";
PATH "TS_J4_TO_D2_ila_pro_0_path" TIG;
TS_J_CLK = PERIOD TIMEGRP "J_CLK" 30 ns HIGH 50%;
TS_U_TO_J = MAXDELAY FROM TIMEGRP "U_CLK" TO TIMEGRP "J_CLK" 15 ns;
TS_U_TO_U = MAXDELAY FROM TIMEGRP "U_CLK" TO TIMEGRP "U_CLK" 15 ns;
PATH TS_J_TO_D_path = FROM TIMEGRP "J_CLK" TO TIMEGRP "D_CLK";
PATH "TS_J_TO_D_path" TIG;
PATH TS_D_TO_J_path = FROM TIMEGRP "D_CLK" TO TIMEGRP "J_CLK";
PATH "TS_D_TO_J_path" TIG;
TS_CLK15NS = PERIOD TIMEGRP "TN_CLK15NS" 15 ns HIGH 50%;
TS_RXCLK = PERIOD TIMEGRP "TN_RXCLK" 8 ns HIGH 50%;
TS_TLK_RXCLK_PAD = PERIOD TIMEGRP "TLK_RXCLK_PAD" 8 ns HIGH 50%;
TS_BDCLK_IN_PAD_P = PERIOD TIMEGRP "BDCLK_IN_PAD_P" 20 ns HIGH 50%;
TS_BDCLK_IN_PAD_N = PERIOD TIMEGRP "BDCLK_IN_PAD_N" TS_BDCLK_IN_PAD_P PHASE 10
        ns HIGH 50%;
PATH TS_TLKCLK_TO_BUSCLK_path = FROM TIMEGRP "tlk_imp_tlkclk_clkfx" TO TIMEGRP
        "TN_CLK15NS";
PATH "TS_TLKCLK_TO_BUSCLK_path" TIG;
PATH TS_BUSCLK_TO_TLKCLK_path = FROM TIMEGRP "TN_CLK15NS" TO TIMEGRP
        "tlk_imp_tlkclk_clkfx";
PATH "TS_BUSCLK_TO_TLKCLK_path" TIG;
TS_mi_imp_bdclk_0_1 = PERIOD TIMEGRP "mi_imp_bdclk_0_1" TS_BDCLK_IN_PAD_P HIGH
        50%;
TS_mi_imp_bdclk_2x_1 = PERIOD TIMEGRP "mi_imp_bdclk_2x_1" TS_BDCLK_IN_PAD_P /
        2 HIGH 50%;
TS_mi_imp_bdclk_div_1 = PERIOD TIMEGRP "mi_imp_bdclk_div_1" TS_BDCLK_IN_PAD_P
        * 2 HIGH 50%;
TS_mi_imp_bdclk_0_2 = PERIOD TIMEGRP "mi_imp_bdclk_0_2" TS_BDCLK_IN_PAD_N HIGH
        50%;
TS_mi_imp_bdclk_2x_2 = PERIOD TIMEGRP "mi_imp_bdclk_2x_2" TS_BDCLK_IN_PAD_N /
        2 HIGH 50%;
TS_mi_imp_bdclk_div_2 = PERIOD TIMEGRP "mi_imp_bdclk_div_2" TS_BDCLK_IN_PAD_N
        * 2 HIGH 50%;
TS_tlk_imp_tlkclk_clkfx = PERIOD TIMEGRP "tlk_imp_tlkclk_clkfx" TS_CLK15NS /
        1.875 HIGH 50%;
TS_mi_imp_bdclk_0 = PERIOD TIMEGRP "mi_imp_bdclk_0" TS_CLK15NS HIGH 50%;
TS_mi_imp_bdclk_2x = PERIOD TIMEGRP "mi_imp_bdclk_2x" TS_CLK15NS / 2 HIGH 50%;
TS_mi_imp_bdclk_div = PERIOD TIMEGRP "mi_imp_bdclk_div" TS_CLK15NS * 2 HIGH
        50%;
PIN
        U_icon_pro/U0/U_ICON/I_YES_BSCAN.U_BS/I_V4.ISYN.I_USE_SOFTBSCAN_EQ0.U_BS_pins<2>
        = BEL
        "U_icon_pro/U0/U_ICON/I_YES_BSCAN.U_BS/I_V4.ISYN.I_USE_SOFTBSCAN_EQ0.U_BS"
        PINNAME SHIFT;
PIN
        "U_icon_pro/U0/U_ICON/I_YES_BSCAN.U_BS/I_V4.ISYN.I_USE_SOFTBSCAN_EQ0.U_BS_pins<2>"
        TIG;
TIMEGRP "TG_RX" OFFSET = IN 4 ns VALID 8 ns BEFORE COMP "GMII_RXCLK_PAD"
        "RISING";
SCHEMATIC END;

