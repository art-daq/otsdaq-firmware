#pta 34    STRIP_OUT1_3_PAD_N<0>]	
#pta 27    STRIP_OUT1_4_PAD_P<0>]	
#pta 28    STRIP_OUT1_4_PAD_N<0>]	

net  fmc_lpc_la17_cc_p         loc = ab27 | iostandard=LVDS_25; # bank  13 vcco - vadj_fpga - io_l12p_t1_mrcc_13
net  fmc_lpc_la17_cc_n         loc = ac27 | iostandard=LVDS_25; # bank  13 vcco - vadj_fpga - io_l12n_t1_mrcc_13
