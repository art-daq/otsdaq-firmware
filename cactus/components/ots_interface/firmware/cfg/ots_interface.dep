src *.vhd
#src data_manager/*.vhd
#src ethernet_controller/*.vhd
#src ethernet_controller/*.v

src *.v

#Note: this was replaced by Jamieson's fifo for 7 series FPGAs (and potentialy 5 and 6 series)
?toolset=="ISE"? src --cd ../cgn DATA_FIFO_0.xco
?toolset=="ISE"? src --cd ../cgn INFO_FIFO_0.xco
?toolset=="ISE"? src --cd ../cgn ADDR_FIFO.xco
?toolset=="Vivado"? src --cd ../cgn DATA_FIFO_0.xci
?toolset=="Vivado"? src --cd ../cgn INFO_FIFO_0.xci
?toolset=="Vivado"? src --cd ../cgn ADDR_FIFO.xci



#this file will either have ram dependencies or be empty depending on user flag
include flash.dep
